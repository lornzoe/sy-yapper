# --- Twitch ---
# Your channel name (no # needed), e.g. TWITCH_CHANNEL=yourchannel
TWITCH_CHANNEL=

# Optional: only needed if anonymous read-only login gets flaky.
# Get a token at https://twitchtokengenerator.com (chat:read scope) and set both:
TWITCH_NICK=
TWITCH_OAUTH_TOKEN=

# --- Voicebox (https://github.com/jamiepine/voicebox) ---
# The Voicebox app must be open/running locally first.
VOICEBOX_BASE_URL=http://127.0.0.1:17493
# Voice profile name or id to speak with. Leave blank to use the first profile
# found (a warning listing all available profiles will be logged on startup).
VOICEBOX_PROFILE=
VOICEBOX_LANGUAGE=en
# TTS engine Voicebox should synthesize with. chatterbox_turbo is the default
# and supports cloned voices. Others available: chatterbox, tada, qwen,
# qwen_custom_voice, luxtts, kokoro -- whichever you have downloaded.
VOICEBOX_ENGINE=chatterbox_turbo
# Seconds to wait on a synthesis request. The cold model load happens inside
# the first request, so this needs headroom above the warmup time.
VOICEBOX_TIMEOUT=180

# --- Audio output ---
# Name (or substring) of the output device to send audio to, e.g. "CABLE Input".
# Leave blank to auto-detect a VB-Audio Cable input device.
# Run `python list_audio_devices.py` to see all device names/indexes.
AUDIO_OUTPUT_DEVICE=

# --- Warmup ---
# Synthesize a throwaway phrase at startup so the first real chat message is
# not stuck behind the model load (~26s for chatterbox_turbo on a cold start).
# The warmup audio is discarded, never played out loud.
WARMUP=true
WARMUP_TEXT=warming up

# --- Emotes ---
# Remove Twitch's own emotes (global, sub, bits) using the exact ranges Twitch
# sends with each message. Messages left with nothing but emotes are skipped.
STRIP_EMOTES=true
# Remove unicode emoji from the spoken text too.
STRIP_EMOJI=true

# --- Behavior ---
# Prefix each message with the chatter's username, e.g. "chatter says hello"
SPEAK_USERNAME=true
# Truncate very long chat messages to this many characters before speaking.
MAX_MESSAGE_LENGTH=300
# How many messages can be queued waiting to be spoken before new ones get dropped.
MAX_QUEUE_SIZE=50
# Usernames (comma-separated, case-insensitive) whose messages are never read aloud.
IGNORE_USERS=nightbot,streamelements,streamlabs,moobot,wizebot
